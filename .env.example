APP_NAME="FeelY Backend"
ENVIRONMENT="local"

# Separate administrator login for /admin.html. Do not enter a plaintext
# password or create the hash manually. After copying this file to .env, run:
# .\.venv\Scripts\python.exe scripts\set_admin_password.py --username admin
# The script fills both values below and stores only a PBKDF2 password hash.
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""
# Admin sessions expire after this many minutes.
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=120

SECRET_KEY="change-this-secret-before-deploying"
DATABASE_URL="sqlite:///./feely.db"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Forwarded headers are resolved by Uvicorn for trusted loopback proxies only.
TRUST_PROXY_HEADERS=false
API_DOCS_ENABLED=false
RATE_LIMIT_HTTP_PER_MINUTE=300
MAX_REQUEST_BODY_BYTES=128000

# Temporary preview protection. Set BASIC_AUTH_ENABLED=true and choose credentials
# to require a browser login before access. Disable it later by setting false.
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USERNAME="preview"
BASIC_AUTH_PASSWORD="change-me"

# Basic abuse protection for public endpoints and LLM cost control.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_AUTH_IP_PER_MINUTE=30
RATE_LIMIT_REGISTER_IP_PER_HOUR=20
RATE_LIMIT_LOGIN_IDENTIFIER_ATTEMPTS=8
RATE_LIMIT_LOGIN_IDENTIFIER_WINDOW_SECONDS=900
RATE_LIMIT_PASSWORD_RESET_IDENTIFIER_PER_HOUR=3
RATE_LIMIT_LLM_USER_PER_MINUTE=30
RATE_LIMIT_LLM_FREE_USER_PER_DAY=10
RATE_LIMIT_LLM_USER_PER_DAY=400

# CAPTCHA blocks automated account creation. Local dev can keep it disabled.
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER="turnstile"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ACTION="register"
TURNSTILE_VERIFY_URL="https://challenges.cloudflare.com/turnstile/v0/siteverify"
TURNSTILE_TIMEOUT_SECONDS=5

# Google account sign-in. Create a Google OAuth Web Client ID for the website origin.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=""
GOOGLE_ALLOWED_HOSTED_DOMAIN=""

# Optional verification email. Requires a real SMTP provider before enabling.
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
# Password reset uses the same SMTP connection as verification email. Configure
# SMTP first, then switch this on.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
PUBLIC_APP_URL="https://app.feel-y.com"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS=true

# Stripe Billing is backend-only and disabled until a Stripe account is configured.
# Never expose STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET to browser code.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Configure at least one recurring Price ID. Monthly and yearly are independently optional.
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
STRIPE_CHECKOUT_SUCCESS_URL=""
STRIPE_CHECKOUT_CANCEL_URL=""
# Safe fallback. Portal launches return to the exact current frontend URL when its origin is trusted.
STRIPE_PORTAL_RETURN_URL=""
PREMIUM_FEATURES_ENABLED=true

# Comma-free JSON list, parsed by pydantic-settings.
# Add the public frontend origin for deployed Cloudflare traffic here.
# If your backend is exposed at api.feel-y.com, the browser origin is app.feel-y.com.
CORS_ORIGINS='["https://feel-y.com", "https://www.feel-y.com", "https://app.feel-y.com", "https://dev.feel-y.com", "https://selinabernard.com", "https://www.selinabernard.com", "http://localhost:3000", "http://localhost:5173", "http://localhost:5500", "http://127.0.0.1:5500", "http://0.0.0.0:5500", "http://localhost:8080", "http://127.0.0.1:8080", "http://0.0.0.0:8080", "null"]'

# Use "mock", "openai", "anthropic", or local generation through "ollama".
LLM_PROVIDER="ollama"
# Optional role-specific overrides. Leave empty to use LLM_PROVIDER.
CHAT_LLM_PROVIDER=""
TOPIC_LLM_PROVIDER="ollama"
# Leave empty to use TOPIC_LLM_PROVIDER, then LLM_PROVIDER.
JOURNAL_LLM_PROVIDER=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
OPENAI_CHAT_MODEL="gpt-5.4-mini"
OPENAI_TOPIC_MODEL="gpt-5.4-mini"
OPENAI_JOURNAL_MODEL="gpt-5.4-mini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_CHAT_MODEL="claude-sonnet-4-6"
ANTHROPIC_TOPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_JOURNAL_MODEL="claude-sonnet-4-6"
ANTHROPIC_MAX_TOKENS=4096

OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3.5:4b"
OLLAMA_CHAT_MODEL="qwen3.5:4b"
OLLAMA_TOPIC_MODEL="qwen3.5:2b"
OLLAMA_JOURNAL_MODEL="qwen3.5:2b"
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_CONTEXT_WINDOW=2048
OLLAMA_CHAT_MAX_TOKENS=768
OLLAMA_TOPIC_MAX_TOKENS=768
OLLAMA_JOURNAL_MAX_TOKENS=768
OLLAMA_CHAT_NUM_GPU=0
OLLAMA_TOPIC_NUM_GPU=999
OLLAMA_JOURNAL_NUM_GPU=999
OLLAMA_KEEP_ALIVE=300
OLLAMA_PREWARM=false
PROMPT_DIRECTORY="prompts"
