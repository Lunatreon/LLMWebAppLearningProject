APP_NAME="FeelY Backend"
ENVIRONMENT="local"
SECRET_KEY="change-this-secret-before-deploying"
DATABASE_URL="sqlite:///./feely.db"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-free JSON list, parsed by pydantic-settings.
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'

# Use "mock" for local development without an API key, or "openai" for a real LLM.
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
