APP_NAME="FeelY Backend"
ENVIRONMENT="local"
SECRET_KEY="change-this-secret-before-deploying"
DATABASE_URL="sqlite:///./feely.db"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=128000

# Temporary preview protection. Set BASIC_AUTH_ENABLED=true and choose credentials
# to require a browser login before access. Disable it later by setting false.
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USERNAME="preview"
BASIC_AUTH_PASSWORD="change-me"

# Basic abuse protection for public endpoints and LLM cost control.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_AUTH_IP_PER_MINUTE=30
RATE_LIMIT_REGISTER_IP_PER_HOUR=20
RATE_LIMIT_LOGIN_IDENTIFIER_ATTEMPTS=8
RATE_LIMIT_LOGIN_IDENTIFIER_WINDOW_SECONDS=900
RATE_LIMIT_LLM_USER_PER_MINUTE=30
RATE_LIMIT_LLM_USER_PER_DAY=400

# CAPTCHA blocks automated account creation. Local dev can keep it disabled.
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER="turnstile"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_VERIFY_URL="https://challenges.cloudflare.com/turnstile/v0/siteverify"
TURNSTILE_TIMEOUT_SECONDS=5

# Google account sign-in. Create a Google OAuth Web Client ID for the website origin.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=""
GOOGLE_ALLOWED_HOSTED_DOMAIN=""

# Optional verification email. Requires a real SMTP provider before enabling.
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PUBLIC_APP_URL="http://127.0.0.1:5500"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS=true

# Comma-free JSON list, parsed by pydantic-settings.
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://localhost:5500", "http://127.0.0.1:5500", "http://localhost:8080", "http://127.0.0.1:8080"]'

# Use "mock", "openai", "anthropic", or local generation through "ollama".
LLM_PROVIDER="ollama"
# Optional role-specific overrides. Leave empty to use LLM_PROVIDER.
CHAT_LLM_PROVIDER=""
TOPIC_LLM_PROVIDER=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
OPENAI_CHAT_MODEL="gpt-5.4-mini"
OPENAI_TOPIC_MODEL="gpt-5.4-mini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_CHAT_MODEL="claude-sonnet-4-6"
ANTHROPIC_TOPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_MAX_TOKENS=4096

OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3.5:4b"
OLLAMA_CHAT_MODEL="qwen3.5:4b"
OLLAMA_TOPIC_MODEL="qwen3.5:4b"
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_CONTEXT_WINDOW=8192
OLLAMA_MAX_TOKENS=1024
