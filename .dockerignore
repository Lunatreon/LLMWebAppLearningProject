# Allow only the backend runtime inputs. Local secrets/data/frontends never enter the build context.
*
!requirements.txt
!alembic.ini
!backend/
!backend/**
!migrations/
!migrations/**
!deployment/
deployment/**
!deployment/backend.Dockerfile
!deployment/__init__.py
!deployment/entrypoint.py
!deployment/healthcheck.py
!scripts/
scripts/**
!scripts/database_migration.py
!prompts/
prompts/**
!prompts/*.txt
**/__pycache__/
**/*.pyc
**/*.pyo
.env
.env.*
**/.env
**/.env.*
**/*.db
**/*.sqlite*
**/credentials*
