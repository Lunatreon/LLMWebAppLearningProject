# Allow only the backend runtime inputs. Local secrets/data/frontends never enter the build context.
*
!Dockerfile
!requirements.txt
!alembic.ini
!app/
!app/**
!migrations/
!migrations/**
!deployment/
deployment/**
!deployment/__init__.py
!deployment/entrypoint.py
!deployment/healthcheck.py
!scripts/
scripts/**
!scripts/database_migration.py
!prompts/
prompts/**
!prompts/*.txt
!docs/
docs/**
!docs/pattern_recognition.txt
**/__pycache__/
**/*.pyc
**/*.pyo
.env
.env.*
**/.env
**/.env.*
**/*.db
**/*.sqlite*
**/credentials*
