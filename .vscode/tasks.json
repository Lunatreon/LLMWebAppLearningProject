{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FeelY: Start Docker",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.docker",
        "up",
        "-d",
        "--build",
        "--wait"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "FeelY: Stop Docker",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.docker",
        "down"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "FeelY: Status Docker",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.docker",
        "ps"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "FeelY: Logs Docker",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "--env-file",
        ".env.docker",
        "logs",
        "--follow",
        "--tail",
        "100"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
