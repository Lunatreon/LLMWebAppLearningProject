# Local Docker only. Generate .env.docker with deployment/setup.py.
# Use docker compose --env-file .env.docker ...; leave the SQLite .env unchanged.
ENVIRONMENT="development"
POSTGRES_DB="feely"
POSTGRES_USER="feely"
POSTGRES_PASSWORD="__POSTGRES_PASSWORD__"
DATABASE_URL="postgresql+psycopg://feely:__DATABASE_PASSWORD__@postgres:5432/feely"
SECRET_KEY="__SECRET_KEY__"
# Back up this independent map-encryption key; never rotate it by regenerating the file.
CONTENT_ENCRYPTION_KEYS='{"primary":"__CONTENT_KEY__"}'
CONTENT_ENCRYPTION_KEY_ID=primary
FEELY_API_PORT=8000
FEELY_WEB_PORT=5173
FEELY_MAILPIT_PORT=8025

PUBLIC_APP_URL="http://127.0.0.1:5173"
CORS_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:5500","http://localhost:5500"]'
API_DOCS_ENABLED=false
BASIC_AUTH_ENABLED=false
TRUST_PROXY_HEADERS=false
CAPTCHA_ENABLED=false
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=true
PASSWORD_RESET_ENABLED=true

SMTP_HOST="mailpit"
SMTP_PORT=1025
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@example.com"
# Unencrypted/auth-free SMTP is for this local capture service only.
SMTP_USE_TLS=false
SMTP_USE_SSL=false
# Optional shared admin inbox. See docs/EMAIL_SETUP.md.
WEBMAIL_ENABLED=false
WEBMAIL_PROVIDER=imap
WEBMAIL_ADDRESS="info@example.com"
WEBMAIL_IMAP_HOST=""
WEBMAIL_IMAP_PORT=993
WEBMAIL_IMAP_USERNAME=""
WEBMAIL_IMAP_PASSWORD=""
WEBMAIL_IMAP_FOLDER="INBOX"
WEBMAIL_IMAP_USE_SSL=true
# Cloudflare alternative only:
WEBMAIL_WORKER_URL=""
WEBMAIL_BRIDGE_SECRET=""
FEEDBACK_ENABLED=true
FEEDBACK_EMAIL_TO=""

# Existing free test-phase switch makes Map usable without Stripe.
PREMIUM_FEATURES_ENABLED=false
STRIPE_ENABLED=false
TERMS_VERSION=""
TERMS_DOCUMENT_URL=""
TERMS_DOCUMENT_SHA256=""

# Mock does not require credentials or a model server. Provider code is unchanged.
LLM_PROVIDER="mock"
CHAT_LLM_PROVIDER=""
TOPIC_LLM_PROVIDER=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_PREWARM=false
PROMPT_DIRECTORY="/app/prompts"
