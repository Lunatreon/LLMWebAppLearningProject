# Copy to .env.production outside version control; replace every <placeholder>.
# Generate JWT/DB passwords with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep the same SECRET_KEY across restarts/restores. Never put backend secrets in VITE_*.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://feely_app:<url-safe-app-db-password>@postgres:5432/feely
SECRET_KEY=<random-jwt-signing-secret-at-least-32-characters>
POSTGRES_DB=feely
POSTGRES_USER=feely_bootstrap
POSTGRES_PASSWORD=<separate-random-bootstrap-db-password>
POSTGRES_APP_USER=feely_app
POSTGRES_APP_PASSWORD=<same-url-safe-app-db-password-as-DATABASE_URL>

# Initial topology: React and /api/v1 share this Caddy HTTPS hostname.
INGRESS_DOMAIN=<app-domain>
ACME_EMAIL=<certificate-contact-email>
PUBLIC_APP_URL=https://<app-domain>
CORS_ORIGINS=["https://<app-domain>"]
ALLOWED_HOSTS=["<app-domain>"]
# Change the subnet and both reserved addresses together if they overlap another network.
FEELY_PROXY_SUBNET=172.30.20.0/24
FEELY_PROXY_IP=172.30.20.2
FEELY_BACKEND_IP=172.30.20.3
FEELY_PRODUCTION_APP_ENV_FILE=.env.production.backend

API_DOCS_ENABLED=false
BASIC_AUTH_ENABLED=false
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ENABLED=true
PROMPT_DIRECTORY=/app/prompts

EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=true
PASSWORD_RESET_ENABLED=true
SMTP_HOST=<smtp-provider-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM_EMAIL=<verified-sender-mailbox>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=<production-public-site-key>
TURNSTILE_SECRET_KEY=<production-secret-key>
TURNSTILE_ACTION=register
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

LLM_PROVIDER=openai
CHAT_LLM_PROVIDER=openai
TOPIC_LLM_PROVIDER=openai
JOURNAL_LLM_PROVIDER=openai
OPENAI_API_KEY=<backend-only-openai-api-key>
OPENAI_MODEL=gpt-5.4-mini
# Per-attempt SDK timeout; retries are bounded separately. Cancellation stops the await.
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OLLAMA_PREWARM=false

TERMS_VERSION=<published-terms-version>
TERMS_DOCUMENT_URL=https://<document-host>/<terms-document.pdf>
TERMS_DOCUMENT_SHA256=<64-lowercase-hex-digest-of-the-published-document>

# Keep the existing free test-phase policy until billing is deliberately enabled.
PREMIUM_FEATURES_ENABLED=false
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
WEBMAIL_ENABLED=false
WEBMAIL_WORKER_URL=
WEBMAIL_BRIDGE_SECRET=
FEEDBACK_ENABLED=true
FEEDBACK_EMAIL_TO=

# Public build inputs only. Empty/unset API base also selects same-origin /api/v1.
VITE_API_BASE_URL=/api/v1
VITE_LEGACY_APP_URL=/reference/
VITE_LEGACY_SIGN_IN_URL=/reference/
