# The independently running reference website. No trailing path is needed.
VITE_LEGACY_APP_URL=http://127.0.0.1:5500/
# Public API configuration replaces the legacy meta value on non-local hosts.
# Local hosts still use port 8000; use ?api_base=... for a local override.
VITE_API_BASE_URL=https://api.feel-y.com/api/v1
# Same-origin reference login bridge, served by the local Vite proxy.
VITE_LEGACY_SIGN_IN_URL=/reference/
